{
  "name": "fabrics-quest",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "template": {
    "name": "blankapp",
    "displayName": "Blank App",
    "description": "Bare-bones Fabric-authenticated React + Vite app \u2014 sign-in, routing, and a placeholder home page, with no data layer to remove"
  },
  "scripts": {
    "prebuild": "rayfin env --framework vite",
    "dev": "rayfin dev",
    "dev:frontend": "vite",
    "build": "tsc -b && vite build",
    "build:fabric": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "rayfin:up": "rayfin up",
    "lint:world": "tsx scripts/lint-world.ts",
    "replay": "tsx scripts/replay.ts",
    "cheat-sheet": "tsx scripts/cheat-sheet.ts",
    "e2e": "playwright test",
    "test:all": "npm test && npm run lint:world && npm run e2e",
    "build:pages": "vite build --mode pages"
  },
  "dependencies": {
    "@microsoft/rayfin-client": "^1.35.1",
    "@microsoft/rayfin-core": "^1.35.1",
    "@microsoft/rayfin-data": "^1.35.1",
    "@microsoft/rayfin-local-dev": "^1.35.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@microsoft/rayfin-cli": "^1.35.1",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "vite": "^7.3.2",
    "vitest": "^3.2.4"
  }
}
